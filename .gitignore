docs/pdf/

# Heavy binaries live on the lab server or move via rsync, never via git.
*.npz
*.npy
*.pt
*.pth
*.wav
*.tar.gz

# Generated experiment artifacts, feature caches, and local runs.
data/raw/
data/interim/
data/features/
features/
results/track2_technique/*.jsonl
results/data_repair/
results/logs/
results/stage1_*_run/
results/stage1_wrapper_probe_run/
runs/*
!runs/README.md

# Editor local config
.vscode/
notes/
